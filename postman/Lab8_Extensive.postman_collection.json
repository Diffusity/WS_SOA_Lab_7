    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:30080/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "30080",
              "path": ["users"]
            }
          }
        },
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"user_id\", jsonData._id || jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"John Doe {{ $randomInt }}\",\n    \"email\": \"john.doe.{{ $randomInt }}@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:30080/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "30080",
              "path": ["users"]
            }
          }
        }
